      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d"
      },
      "package": "com.shahjalal.rokiai",
      "permissions": [
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE"
      ]
    }
  }
}
